{"nodes": [{"id": "simulation_logic_compound_asymmetry", "label": "The Compound Asymmetry", "file_type": "rationale", "source_file": "simulation-logic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compound known only for the hypothetical strategy; baseline uses recorded lap times. Inferring real compounds from pit spacing is forbidden; deriving degradation magnitude is allowed."}, {"id": "simulation_logic_step0_pace_model", "label": "Step 0: Derive Race Pace Model", "file_type": "concept", "source_file": "simulation-logic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "simulation_logic_tire_degradation_model", "label": "Step 1: Tire Degradation Lap-Time Model", "file_type": "concept", "source_file": "simulation-logic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "base_pace is now a fitted intercept, removing the old centring hack that favoured the driver's actual compound."}, {"id": "simulation_logic_pit_stop_penalty", "label": "Step 2: Pit Stop Penalty (20-25s)", "file_type": "concept", "source_file": "simulation-logic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Randomized per run; models total pit-lane loss, same quantity as Jolpica PitStops duration, not 2-3s wheel-gun time."}, {"id": "simulation_logic_incremental_recompute", "label": "Step 3: Recompute Only Changed Laps", "file_type": "concept", "source_file": "simulation-logic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "simulation_logic_track_position_resolution", "label": "Step 4: Track Position via Cumulative Time (undercut/overcut)", "file_type": "concept", "source_file": "simulation-logic.md", "source_location": null, "source_url": null, "capt