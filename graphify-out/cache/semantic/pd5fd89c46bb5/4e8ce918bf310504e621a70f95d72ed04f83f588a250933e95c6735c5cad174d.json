{"nodes": [{"id": "degradation_model_joint_stint_fit", "label": "Joint Multi-Stint Lap-Time Fit", "file_type": "rationale", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Within one stint fuel burn and tire age are collinear; the pit-stop reset of tire age is what separates them, so stints must be fitted jointly. A per-stint fit understates degradation by ~0.05 s/lap."}, {"id": "degradation_model_stint_segmentation", "label": "Step A: Stint Segmentation", "file_type": "concept", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "degradation_model_green_flag_filter", "label": "Step B: Green-Flag Tire Pace Filter", "file_type": "concept", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drop lap 1, in/out laps, neutralized laps and slow one-sided residual outliers (traffic only makes laps slower)."}, {"id": "degradation_model_neutralization_detection", "label": "Safety Car/VSC Detection via Field Median", "file_type": "concept", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jolpica has no track-status; field median > 1.15x rolling baseline flags a neutralization. Field spread (1.6x green spread threshold) separates SC (bunched) from rain (scattered)."}, {"id": "degradation_model_weather_detection", "label": "Race-Level Weather Detection (two checks)", "file_type": "concept", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Check 1 catches within-race regime shifts; check 2 compares green pace against same circuit's dry races (\u00b13 seasons, >10% slower) to catch lights-to-flag wet races."}, {"id": "degradation_model_pooled_fuel_coefficient", "label": "Step C: Pooled Per-Race Fuel Coefficient", "file_type": "concept", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-driver-stint intercepts made the design rank deficient; one intercept per driver identifies fuel. Clamped to [0.02,0.12], fallback 0.055."}, {"id": "degradation_model_quality_gate", "label": "Step D: Stint Quality Gate (good/sparse/unreliable)", "file_type": "concept", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ">=8 laps good, >=5 sparse with stderr x1.5, else unreliable; thresholds are still unvalidated guesses."}, {"id": "degradation_model_fallback_tiers", "label": "Step E: Fallback Tiers (driver/team-mate/field/generic)", "file_type": "concept", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Team-mate tier added because the same car on the same track beats a generic curve; tier 2 picks the lower-stderr team-mate rather than a blend."}, {"id": "degradation_model_compound_multiplier", "label": "Step F: Compound as Degradation Multiplier", "file_type": "concept", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Magnitude from data, ratio from table (soft 1.6, medium 1.0, hard 0.6, inter 1.2, wet 0.8); fresh-tire pace offsets remain absolute."}, {"id": "degradation_model_compound_model_table", "label": "COMPOUND_MODEL Generic Table", "file_type": "concept", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Demoted from absolute degradation source to relative ratio source; absolute values kept as tier-4 fallback."}, {"id": "degradation_model_extrapolation_envelope", "label": "Step G: Extrapolation Envelopes (A_driver / A_race)", "file_type": "concept", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Linear extrapolation made unsurvivable stints look fast; stderr inflates past A_driver and a quadratic excess applies past A_race. Absurd strategies flagged beyond_evidence, not rejected."}, {"id": "degradation_model_kappa_excess_term", "label": "Quadratic Excess Term (kappa = 0.35 x field median)", "file_type": "concept", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scaling off the driver made flattered cars' cliffs free; scaling by compound discounted hards 40%. The cliff belongs to the tire and circuit, shared by the field. Still uncalibrated."}, {"id": "degradation_model_degradation_floor", "label": "Degradation Floor max(driver, 0.5 x field median, 0.020)", "file_type": "concept", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Near-zero slopes are trim artefacts; floor applied at every tier and again after the compound ratio, because a floor is a claim about lap time that shouldn't weaken on harder rubber."}, {"id": "degradation_model_degradation_resampling", "label": "Step H: Degradation Resampling in Monte Carlo", "file_type": "concept", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resample degradation from Normal(fitted, stderr) so extrapolations yield visibly wide distributions instead of confident fantasies."}, {"id": "degradation_model_reference_compound_error", "label": "Unknown Reference Compound (largest systematic error)", "file_type": "rationale", "source_file": "degradation-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derived slope is treated as medium-equivalent though the real compound is unknown; unfixable without FastF1 compound data. Biases compound comparisons more than driver comparisons."}], "edges": [{"source": "degradation_model_joint_stint_fit", "target": "degradation_model_pooled_fuel_coefficient", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_stint_segmentation", "target": "data_model_pit_stops_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_green_flag_filter", "target": "degradation_model_neutralization_detection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_green_flag_filter", "target": "degradation_model_weather_detection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_neutralization_detection", "target": "degradation_model_weather_detection", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_weather_detection", "target": "data_model_race_pace_models_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_neutralization_detection", "target": "simulation_logic_safety_car_randomness", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_quality_gate", "target": "data_model_driver_stint_fits_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_fallback_tiers", "target": "degradation_model_quality_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_fallback_tiers", "target": "degradation_model_compound_model_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_compound_multiplier", "target": "degradation_model_compound_model_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_extrapolation_envelope", "target": "degradation_model_kappa_excess_term", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_extrapolation_envelope", "target": "degradation_model_degradation_floor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_degradation_floor", "target": "degradation_model_compound_multiplier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_degradation_resampling", "target": "degradation_model_extrapolation_envelope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_degradation_resampling", "target": "simulation_logic_monte_carlo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_reference_compound_error", "target": "simulation_logic_fastf1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_reference_compound_error", "target": "degradation_model_compound_multiplier", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}, {"source": "degradation_model_joint_stint_fit", "target": "simulation_logic_compound_asymmetry", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "step0_pace_model_pipeline", "label": "Step 0 Pace-Model Derivation Pipeline (Steps A-E)", "nodes": ["degradation_model_stint_segmentation", "degradation_model_green_flag_filter", "degradation_model_pooled_fuel_coefficient", "degradation_model_quality_gate", "degradation_model_fallback_tiers", "simulation_logic_step0_pace_model"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "degradation-model.md"}]}